# Optional path prefix for GitHub project pages.
NEXT_PUBLIC_BASE_PATH=/repository

# Signals custom-domain mode in GitHub Pages deployment automation.
SITE_CUSTOM_DOMAIN=pesnya-tebe.ru

# Public read-only media origin. This is a documentation example, not a real domain.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.ru

# Optional external links for the temporary 2026 event page.
NEXT_PUBLIC_EVENT_2026_PHOTOS_URL=
NEXT_PUBLIC_EVENT_2026_REDIRECT_URL=
NEXT_PUBLIC_EVENT_2026_VIDEO_BASE_URL=https://video.example.ru
